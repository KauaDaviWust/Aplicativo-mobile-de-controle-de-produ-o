<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Usamos insets negativos para "empurrar" as linhas superior e esquerda para fora da vista -->
    <!-- Isso evita que as linhas se somem quando as células estão lado a lado -->
    <item
        android:top="-1dp"
        android:left="-1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#DCDCDC" /> <!-- Cor cinza claro para um visual moderno -->
            <solid android:color="#FFFFFF" /> <!-- Fundo branco da célula -->
        </shape>
    </item>
</layer-list>
